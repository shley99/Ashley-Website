---
import modelData from '../content/canva-home.json';
import type { CanvaHomeModel } from '../types/canva';
import CanvaNode from './CanvaNode.astro';
import '../styles/canva-home.css';

const model = modelData as CanvaHomeModel;
---
<main id="main" class="canva-home" tabindex="-1">
  {model.pages.map((page) => (
    <section
      id={page.id}
      class:list={['canva-page', `canva-page--${page.id}`]}
      style={[
        `--page-background:${page.background}`,
        `--source-height:${page.height}px`,
        `--source-ratio:${page.height / page.width}`,
        `--mobile-ratio:${page.mobileHeight / page.mobileWidth}`,
      ].join(';')}
      aria-label={page.label}
      data-canva-page
    >
      <div class="canva-artboard">
        {page.nodes.map((node) => (
          <CanvaNode
            node={node}
            pageId={page.id}
            pageWidth={page.width}
            pageHeight={page.height}
            mobilePageWidth={page.mobileWidth}
            mobilePageHeight={page.mobileHeight}
          />
        ))}
      </div>
    </section>
  ))}
</main>

<script>
  import '../scripts/canva-motion';
  import '../scripts/canva-interactions';
</script>
