---
import clickSound from '../content/cursor-audio.json';
import { withBase } from '../lib/site';
---
<div class="cat-cursor" id="studio-cat" aria-hidden="true" hidden>
  <svg class="cursor-art" viewBox="0 0 40 40" width="36" height="36" focusable="false">
    <path class="cat-outline" d="M4 3 15 11Q21 8 27 12L35 6 34 23Q34 35 20 36 5 35 5 23Z" fill="#b7a07a" stroke="#382f27" stroke-width="1.9" stroke-linejoin="round" />
    <path d="m7 8 6 5-5 3Zm24 7 2-5-4 4Z" fill="#b98179" />
    <g class="cat-tabby-markings" fill="#554734">
      <path d="m14 11 3 1.5 3 4 3-4 3-1-1 6-2.5-1-2.5 3-3-3-2 1Z" />
      <path d="m6 17 7 3-1.5 2L6 20Zm-.2 5 5.5 2-1 2-4.5-1Zm26-4-6 2.5 1 1.8 5.5-1.8Zm1 5-5 1.5 1 1.8 4.2-1.5Z" />
      <path d="m9 13 4 2.5-2.5.5Zm21 1-3 2 3 .5Z" />
    </g>
    <g class="cat-face">
      <path class="cat-muzzle" d="M10.5 28Q14 24 20.5 26Q27 24 31 28L29 32Q25 35 20 35Q14 34.5 11.5 31Z" fill="#eee4d0" />
      <g class="cat-eyes">
        <g fill="#9da669" stroke="#382f27" stroke-width=".8">
          <ellipse cx="14" cy="23" rx="2.7" ry="2.1"/>
          <ellipse cx="27" cy="23" rx="2.7" ry="2.1"/>
        </g>
        <g fill="#30291f"><ellipse cx="14" cy="23" rx=".8" ry="1.9"/><ellipse cx="27" cy="23" rx=".8" ry="1.9"/></g>
        <g fill="#f7f2e6"><circle cx="13.3" cy="22.3" r=".5"/><circle cx="26.3" cy="22.3" r=".5"/></g>
      </g>
      <path d="m18.4 27 2.1 2 2.1-2" fill="#9c685e" stroke="#47382c" stroke-width="1" stroke-linejoin="round"/>
      <path d="M20.5 29v1.5m0 0q-2 2-4 .2m4-.2q2 2 4 .2M3 24l6 2m-6 4 6-1m22-3 7-2m-7 5 6 1" fill="none" stroke="#47382c" stroke-width="1.2" stroke-linecap="round"/>
    </g>
  </svg>
</div>
<template id="paw-template">
  <svg class="paw-stamp" viewBox="0 0 32 32" width="24" height="24" aria-hidden="true" focusable="false">
    <g fill="#554734" stroke="#eee4d0" stroke-width=".8"><path d="M9 23c0-4 3-9 7-9s7 5 7 9c0 3-3 4-7 2-4 2-7 1-7-2Z"/><ellipse cx="7" cy="14" rx="3" ry="4" transform="rotate(-25 7 14)"/><ellipse cx="12" cy="8" rx="3" ry="4"/><ellipse cx="21" cy="8" rx="3" ry="4"/><ellipse cx="26" cy="14" rx="3" ry="4" transform="rotate(25 26 14)"/></g>
  </svg>
</template>
<audio id="studio-cat-click-audio" preload="none" data-click-sound-src={withBase(clickSound.src)} hidden></audio>
<button class="studio-cat-sound-toggle" type="button" data-cat-sound-toggle data-fidelity-extra aria-label="Studio Cat click sound" aria-pressed="true" hidden>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M4 9v6h4l5 4V5L8 9H4Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    <path class="cat-sound-on" d="M16 9a4 4 0 0 1 0 6m3-9a8 8 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    <path class="cat-sound-off" d="m17 9 5 6m0-6-5 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
</button>
<span class="visually-hidden" data-cat-sound-status role="status"></span>
