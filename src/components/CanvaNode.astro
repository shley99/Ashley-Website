---
import type {
  CanvaImageNode,
  CanvaNode,
  CanvaTextNode,
  CanvaVectorNode,
  CanvaVideoNode,
} from '../types/canva';
import videoData from '../content/videos.json';
import newsletter from '../content/newsletter.json';
import newsletterMotion from '../content/newsletter-motion.json';
import { portfolio } from '../content/portfolio';
import { withBase } from '../lib/site';

interface Props {
  node: CanvaNode;
  pageId: string;
  pageWidth: number;
  pageHeight: number;
  mobilePageWidth: number;
  mobilePageHeight: number;
}

const { node, pageId, pageWidth, pageHeight, mobilePageWidth, mobilePageHeight } = Astro.props;
const nodeStyle = [
  `--node-left:${node.x / pageWidth * 100}%`,
  `--node-top:${node.y / pageHeight * 100}%`,
  `--node-width:${node.width / pageWidth * 100}%`,
  `--node-height:${node.height / pageWidth * 100}cqw`,
  `--node-rotation:${node.rotation}deg`,
  `--mobile-node-left:${node.mobile.x / mobilePageWidth * 100}%`,
  `--mobile-node-top:${node.mobile.y / mobilePageHeight * 100}%`,
  `--mobile-node-width:${node.mobile.width / mobilePageWidth * 100}%`,
  `--mobile-node-width-cqw:${node.mobile.width / mobilePageWidth * 100}cqw`,
  `--mobile-node-height:${node.mobile.height / mobilePageWidth * 100}cqw`,
  `--mobile-node-rotation:${node.mobile.rotation}deg`,
  `--node-z:${Math.round(node.index * 100)}`,
].join(';');

const altByRole: Record<string, string> = {
  wordmark: 'Ashley Naoko.',
  'ashley-and-cat': 'Ashley holding her cat.',
  'christmas-card': 'A custom Christmas card styled as collectible cat character cards.',
  'youtube-avatar': 'Ashley Naoko YouTube channel avatar.',
  tinkercad: 'A flower-handled mug being modeled in TinkerCAD.',
  slicer: 'The mug model prepared for 3D printing.',
  'laser-design': 'A layered pet memorial design in laser-design software.',
  'portrait-prints': 'Two hand-printed portraits in black and green.',
  'workshop-group': 'Ashley helping children make prints at a workshop.',
  'greeting-cards': 'Hand-stamped holiday greeting cards.',
  'holiday-card': 'A handmade Christmas card with character stamps.',
  'community-table': 'Holiday stamps and greeting cards on a community craft table.',
  welding: 'Ashley welding a metal frame.',
  'glass-tumbler': 'A wind-powered glass tumbler made from reused parts.',
};

const majorHeadings = new Set(['CREATIVE PORTFOLIO', 'I’M ASHLEY', 'DIGITAL WORKS', 'PHYSICAL WORKS', 'CONTACT ME']);
const projectHeadings = new Set(['EDITORIAL DESIGN', 'GRAPHIC DESIGN', 'VIDEO EDITING', '3D PRINTING', 'LASER CUTTING', 'PRINTMAKING', 'WELDING']);
const mobileHeadingLines: Record<string, string[]> = {
  'GRAPHIC DESIGN': ['GRAPHIC', 'DESIGN'],
  'LASER CUTTING': ['LASER', 'CUTTING'],
  'CONTACT ME': ['CONTACT', 'ME'],
};

function textTag(text: string) {
  if (text === 'CREATIVE PORTFOLIO') return 'h1';
  if (majorHeadings.has(text)) return 'h2';
  if (projectHeadings.has(text)) return 'h3';
  return 'p';
}

function mediaStyle(mediaNode: CanvaImageNode | CanvaVideoNode) {
  const crop = mediaNode.crop;
  const mobileCrop = mediaNode.mobileCrop;
  return [
    `--crop-left:${crop.x * 100}%`,
    `--crop-top:${crop.y * 100}%`,
    `--crop-width:${crop.width * 100}%`,
    `--crop-height:${crop.height * 100}%`,
    `--crop-rotation:${crop.rotation}deg`,
    `--mobile-crop-left:${mobileCrop.x * 100}%`,
    `--mobile-crop-top:${mobileCrop.y * 100}%`,
    `--mobile-crop-width:${mobileCrop.width * 100}%`,
    `--mobile-crop-height:${mobileCrop.height * 100}%`,
    `--mobile-crop-rotation:${mobileCrop.rotation}deg`,
  ].join(';');
}

const ambientVideos = new Set([
  'portrait-stamp',
  'carving-block',
  'pulling-print',
  'stamp-workshop',
  'laser-engraving',
]);
const channelVideos = new Set(['japan-march', 'japan-february']);
const compactMotion: Record<string, [number, number]> = {
  LBpXlxrypPRVzGzW: [2.5, -1.15],
  LBhw8F3CDkDvmqg1: [3.15, -2.05],
  LBZXkFBD6GXKStPP: [2.8, -.65],
  LBkGhBgrSJ5bBV58: [3.35, -1.45],
  LB2Gn4btfHQ4sKPN: [2.65, -2.2],
};

const firstPage = newsletter.pages[0];
const inlineNewsletterPages = JSON.stringify(newsletter.pages.map((page) => {
  const motion = newsletterMotion.pages.find((entry) => entry.number === page.number);
  return {
    number: page.number,
    src: withBase(page.src),
    width: page.width,
    height: page.height,
    previewQuality: page.previewQuality,
    motion: motion ? {
      background: withBase(motion.background),
      layers: motion.layers.map((layer) => ({
        ...layer, src: withBase(layer.src), still: withBase(layer.still),
      })),
    } : undefined,
  };
}));
---
{node.type === 'text' && (() => {
  const textNode = node as CanvaTextNode;
  const Tag = textTag(textNode.text);
  const isDisplayText = textNode.style.family === 'Partita 1990';
  const textStyle = [
    nodeStyle,
    `--text-size:${textNode.style.size / pageWidth * 100}cqw`,
    `--mobile-text-size:${(textNode.mobileTextSize ?? textNode.style.size * mobilePageWidth / pageWidth) / mobilePageWidth * 100}cqw`,
    `--text-line-height:${textNode.style.lineHeight}`,
    `--mobile-text-line-height:${textNode.mobileLineHeight ?? textNode.style.lineHeight}`,
    `--desktop-display-scale-x:${textNode.style.desktopScaleX}`,
    `--desktop-display-scale-y:${textNode.style.desktopScaleY}`,
    `--display-offset-x:${textNode.style.desktopOffsetX / pageWidth * 100}cqw`,
    `--display-offset-y:${textNode.style.desktopOffsetY / pageWidth * 100}cqw`,
    `--mobile-display-scale-x:${textNode.style.mobileScaleX}`,
    `--mobile-display-scale-y:${textNode.style.mobileScaleY}`,
    `--text-transform-origin:${textNode.style.align} center`,
    `--text-align:${textNode.style.align}`,
    `--type-duration:${textNode.duration ?? 1.6}s`,
    `--type-steps:${Math.max(1, textNode.text.length)}`,
    `--type-step:${(textNode.duration ?? 1.6) / Math.max(1, Array.from(textNode.text).length)}s`,
    `font-family:${isDisplayText ? 'var(--font-display)' : `'${textNode.style.family}'`}`,
    `font-weight:${textNode.style.weight}`,
    `font-style:${textNode.style.style}`,
    'line-height:var(--text-line-height)',
    `letter-spacing:${textNode.style.letterSpacing}`,
    `text-align:${textNode.style.align}`,
    `color:${textNode.style.color}`,
  ].join(';');
  const content = textNode.text;
  const typewriter = textNode.effect === 'typewriter';
  const desktopLines = textNode.lines.length ? textNode.lines : [content];
  const mobileLines = mobileHeadingLines[content] ?? [content];
  const desktopLineOffsets = desktopLines.map((_, lineIndex) =>
    desktopLines.slice(0, lineIndex).reduce((total, line) => total + Array.from(line).length, 0)
  );
  const mobileLineOffsets = mobileLines.map((_, lineIndex) =>
    mobileLines.slice(0, lineIndex).reduce((total, line) => total + Array.from(line).length, 0)
  );
  const textClasses = ['canva-node', 'canva-node--text', {
    'canva-node--display-text': isDisplayText,
    'canva-node--fitted-text': textNode.fitted,
  }];
  const visualContent = (
    <>
      <span class="canva-text-content canva-text-content--desktop" aria-hidden={typewriter ? 'true' : undefined}>
        {desktopLines.map((line, lineIndex) => (
          <span class="canva-text-line" data-authored-line>
            {typewriter
              ? Array.from(line).map((character, index) => (
                <span class="canva-type-character" style={`--type-index:${desktopLineOffsets[lineIndex] + index}`}>{character === ' ' ? '\u00a0' : character}</span>
              ))
              : textNode.lineRuns[lineIndex].map((run) => (
                <span style={`color:${run.color};font-weight:${run.weight};font-style:${run.style}`}>{run.text}</span>
              ))}
          </span>
        ))}
      </span>
      <span class="canva-text-content canva-text-content--mobile" aria-hidden={typewriter ? 'true' : undefined}>
        {mobileLines.map((line, lineIndex) => (
          <span class="canva-text-line">
            {typewriter
              ? Array.from(line).map((character, index) => (
                <span class="canva-type-character" style={`--type-index:${mobileLineOffsets[lineIndex] + index}`}>{character === ' ' ? '\u00a0' : character}</span>
              ))
              : line}
          </span>
        ))}
      </span>
      {typewriter && <span class="visually-hidden">{content}</span>}
    </>
  );
  if (content === portfolio.phone) {
    return <a class:list={[...textClasses, 'canva-contact-link']} style={textStyle} href={portfolio.phoneHref} data-canva-node-id={textNode.id}>{visualContent}</a>;
  }
  if (content === portfolio.email) {
    return <a class:list={[...textClasses, 'canva-contact-link']} style={textStyle} href={`mailto:${portfolio.email}`} data-canva-node-id={textNode.id}>{visualContent}</a>;
  }
  if (pageId === 'digital' && content === 'Ashley Naoko') {
    return <a class:list={[...textClasses, 'canva-channel-link']} style={textStyle} href={portfolio.youtube} target="_blank" rel="noopener noreferrer" data-canva-node-id={textNode.id}>{visualContent}</a>;
  }
  return (
    <Tag
      class:list={[...textClasses, { 'canva-typewriter': textNode.effect === 'typewriter' }]}
      style={textStyle}
      data-canva-typewriter={textNode.effect === 'typewriter' ? '' : undefined}
      data-reference-low-contrast={textNode.style.color === '#a6a6a6' ? '' : undefined}
      data-vector-link-label={textNode.linkedTo}
      data-canva-node-id={textNode.id}
    >
      {visualContent}
    </Tag>
  );
})()}

{(node.type === 'image' || node.type === 'animation') && (() => {
  const imageNode = node as CanvaImageNode;
  const alt = imageNode.role ? altByRole[imageNode.role] ?? '' : '';
  const eager = pageId === 'home';
  const source = withBase(imageNode.src);
  const mobileQuarterTurn = Math.abs(Math.abs(imageNode.rotation) - 90) < .001 && Math.abs(imageNode.mobile.rotation) < .001;
  return (
    <div
      class:list={['canva-node', 'canva-node--media', {
        'canva-node--source-motion': Boolean(imageNode.continuousMotion),
        'canva-node--mobile-quarter-turn': mobileQuarterTurn,
      }]}
      style={[
        nodeStyle,
        `--mobile-content-rotation:${imageNode.rotation}deg`,
        compactMotion[imageNode.id] ? `--compact-motion-duration:${compactMotion[imageNode.id][0]}s;--compact-motion-delay:${compactMotion[imageNode.id][1]}s` : '',
      ].join(';')}
      data-hero-entry={pageId === 'home' && imageNode.entrance === 'spring' ? '' : undefined}
      data-continuous-motion={imageNode.continuousMotion ? JSON.stringify(imageNode.continuousMotion) : undefined}
      data-canva-node-id={imageNode.id}
    >
      <div class="canva-entry-shell">
        <div class="canva-motion-shell" data-motion-shell>
          <div class="canva-media" style={mediaStyle(imageNode)}>
            <img
              src={eager ? source : undefined}
              width={Math.max(1, Math.round(imageNode.width))}
              height={Math.max(1, Math.round(imageNode.height))}
              alt={alt}
              loading={eager ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={imageNode.role === 'wordmark' ? 'high' : undefined}
              draggable="false"
              data-image-src={!eager ? source : undefined}
              data-still-src={imageNode.animated ? source : undefined}
              data-animated-src={imageNode.animated ? withBase(imageNode.animated) : undefined}
              data-source-animation={imageNode.animated ? '' : undefined}
            />
            {!eager && (
              <noscript>
                <img
                  src={source}
                  width={Math.max(1, Math.round(imageNode.width))}
                  height={Math.max(1, Math.round(imageNode.height))}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
              </noscript>
            )}
          </div>
        </div>
      </div>
    </div>
  );
})()}

{node.type === 'video' && (() => {
  const videoNode = node as CanvaVideoNode;
  const video = videoData[videoNode.video as keyof typeof videoData];
  const sourceMode = ambientVideos.has(videoNode.video) ? 'ambient' : 'poster';
  return (
    <figure
      class:list={['canva-node', 'canva-node--media', 'canva-video', `canva-video--${sourceMode}`, {
        'canva-video--channel': channelVideos.has(videoNode.video),
      }]}
      style={nodeStyle}
      data-video={videoNode.video}
      data-source-video-mode={sourceMode}
      data-canva-node-id={videoNode.id}
    >
      <div class="canva-media" style={mediaStyle(videoNode)}>
        <video
          controls
          playsinline
          preload="none"
          muted={sourceMode === 'ambient'}
          poster={sourceMode === 'poster' ? withBase(video.poster) : undefined}
          data-poster={sourceMode === 'ambient' ? withBase(video.poster) : undefined}
          data-desktop-poster={videoNode.desktopPoster ? withBase(videoNode.desktopPoster) : undefined}
          data-source-start={videoNode.playback.start}
          data-source-end={videoNode.playback.end}
          data-source-volume={videoNode.playback.volume}
          data-has-audio={video.hasAudio ? 'true' : 'false'}
          width={video.width}
          height={video.height}
          aria-label={video.title}
        >
          <source src={withBase(video.src)} type="video/mp4" />
          <p>Your browser cannot play this video. <a href={withBase(video.src)}>Open {video.title}</a>.</p>
        </video>
      </div>
      <div class="canva-video-controls" data-video-controls hidden>
        <button
          class="canva-video-control canva-video-toggle"
          type="button"
          data-source-video-control
          aria-label={sourceMode === 'ambient' ? `Pause ${video.title}` : `Play ${video.title}`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="canva-video-play-icon" d="m9 7 8 5-8 5Z" fill="currentColor" />
            <path class="canva-video-pause-icon" d="M8 7h3v10H8zm5 0h3v10h-3z" fill="currentColor" />
          </svg>
        </button>
        <div class="canva-video-rail">
          <input
            class="canva-video-seek"
            type="range"
            min="0"
            max="1000"
            step="1"
            value="0"
            data-video-seek
            aria-label={`Seek ${video.title}`}
            disabled
          />
          <button
            class="canva-video-mute"
            type="button"
            data-video-mute
            aria-label={`${sourceMode === 'ambient' ? 'Unmute' : 'Mute'} ${video.title}`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 9v6h4l5 4V5L8 9H4Z" fill="currentColor" />
              <path class="canva-video-sound-icon" d="M16 9.2a4 4 0 0 1 0 5.6M18.5 6.8a7.4 7.4 0 0 1 0 10.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              <path class="canva-video-muted-icon" d="m16 9 5 6m0-6-5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </button>
          <button class="canva-video-fullscreen" type="button" data-video-fullscreen aria-label={`Full screen ${video.title}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4H4v4m12-4h4v4M8 20H4v-4m12 4h4v-4" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
          </button>
        </div>
      </div>
      <p class="media-error" role="status" hidden>This video could not load. <a href={withBase(video.src)}>Open the video file.</a></p>
    </figure>
  );
})()}

{node.type === 'vector' && (() => {
  const vectorNode = node as CanvaVectorNode;
  const pathItems = vectorNode.paths.filter((item) => item.kind === 'path');
  const rectItems = vectorNode.paths.filter((item) => item.kind === 'rect');
  return (
    <div
      class="canva-node canva-node--vector"
      style={nodeStyle}
      data-canva-node-id={vectorNode.id}
    >
      <svg
        class="canva-vector-layer canva-vector-layer--mobile"
        viewBox={vectorNode.viewBox.join(' ')}
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        {vectorNode.paths.map((item) => (
          <path
            d={item.d}
            fill={item.legacyFill}
            fill-opacity={item.legacyFillOpacity}
            stroke={item.stroke}
            stroke-width={item.strokeWidth}
            stroke-dasharray={item.dash.length ? item.dash.join(' ') : undefined}
          />
        ))}
      </svg>
      {rectItems.map((item) => {
        const fill = item.fill.type === 'solid' ? item.fill : undefined;
        return (
          <span
            class="canva-vector-rect canva-vector-layer--desktop"
            aria-hidden="true"
            style={[
              `--vector-radius:${item.cornerRadius / pageWidth * 100}cqw`,
              `--vector-border-width:${item.strokeWidth / pageWidth * 100}cqw`,
              `background:${fill?.color ?? 'transparent'}`,
              `opacity:${fill?.opacity ?? 1}`,
              `border-color:${item.stroke}`,
            ].join(';')}
          />
        );
      })}
      {pathItems.length > 0 && (
        <svg
          class="canva-vector-layer canva-vector-layer--desktop"
          viewBox={vectorNode.viewBox.join(' ')}
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          {pathItems.map((item, itemIndex) => item.fill.type === 'image'
            ? (() => {
              const crop = item.fill.crop;
              const x = vectorNode.viewBox[0] + crop.x * vectorNode.viewBox[2];
              const y = vectorNode.viewBox[1] + crop.y * vectorNode.viewBox[3];
              const width = crop.width * vectorNode.viewBox[2];
              const height = crop.height * vectorNode.viewBox[3];
              const centerX = x + width / 2;
              const centerY = y + height / 2;
              const clipId = `canva-vector-clip-${vectorNode.id}-${itemIndex}`;
              return (
                <>
                  <defs>
                    <clipPath id={clipId} clipPathUnits="userSpaceOnUse">
                      <path d={item.d} />
                    </clipPath>
                  </defs>
                  <image
                    href={withBase(item.fill.src)}
                    x={x}
                    y={y}
                    width={width}
                    height={height}
                    opacity={item.fill.opacity}
                    preserveAspectRatio="none"
                    clip-path={`url(#${clipId})`}
                    transform={crop.rotation ? `rotate(${crop.rotation} ${centerX} ${centerY})` : undefined}
                  />
                  {item.stroke !== 'none' && (
                    <path
                      d={item.d}
                      fill="none"
                      stroke={item.stroke}
                      stroke-width={item.strokeWidth}
                      stroke-dasharray={item.dash.length ? item.dash.join(' ') : undefined}
                      vector-effect="non-scaling-stroke"
                    />
                  )}
                </>
              );
            })()
            : (
              <path
                d={item.d}
                fill={item.fill.type === 'solid' ? item.fill.color : 'none'}
                fill-opacity={item.fill.type === 'solid' ? item.fill.opacity : 1}
                stroke={item.stroke}
                stroke-width={item.strokeWidth}
                stroke-dasharray={item.dash.length ? item.dash.join(' ') : undefined}
                vector-effect="non-scaling-stroke"
              />
            ))}
        </svg>
      )}
      {vectorNode.href && (
        <a
          class="canva-vector-link canva-vector-layer--desktop"
          href={vectorNode.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={vectorNode.linkLabel}
        />
      )}
    </div>
  );
})()}

{node.type === 'line' && (
  <svg
    class="canva-node canva-node--line"
    style={nodeStyle}
    viewBox={`0 0 ${node.width} ${node.height}`}
    preserveAspectRatio="none"
    aria-hidden="true"
    data-line-reveal={node.reveal ? JSON.stringify(node.reveal) : undefined}
    data-canva-node-id={node.id}
  >
    {node.arrowEnd && (
      <defs>
        <marker
          id={`canva-arrow-${node.id}`}
          viewBox={`0 0 ${node.thickness * 4} ${node.thickness * 4}`}
          markerWidth={node.thickness * 4}
          markerHeight={node.thickness * 4}
          refX={node.thickness * 3.5}
          refY={node.thickness * 2}
          markerUnits="userSpaceOnUse"
          orient="auto"
        >
          <path
            d={`M ${node.thickness / 2} ${node.thickness / 2} L ${node.thickness * 3.5} ${node.thickness * 2} L ${node.thickness / 2} ${node.thickness * 3.5} Z`}
            fill={node.color}
          />
        </marker>
      </defs>
    )}
    <path
      d={`M ${node.arrowEnd ? node.thickness / 2 : 0} ${node.height / 2} Q ${node.width / 2} ${node.height / 2 + node.curve} ${node.width - (node.arrowEnd ? node.thickness / 2 : 0)} ${node.height / 2}`}
      fill="none"
      stroke={node.color}
      stroke-width={node.thickness}
      stroke-linecap={node.arrowEnd ? 'round' : 'butt'}
      marker-end={node.arrowEnd ? `url(#canva-arrow-${node.id})` : undefined}
    />
  </svg>
)}

{node.type === 'newsletter' && (
  <div
    class="canva-node canva-node--newsletter"
    style={[
      nodeStyle,
      `--newsletter-previous-cursor:url("${withBase('/media/newsletter-motion/previous-page.svg')}")`,
      `--newsletter-next-cursor:url("${withBase('/media/newsletter-motion/next-page.svg')}")`,
    ].join(';')}
    data-newsletter-reader
    data-native-cursor
    data-newsletter-pages={inlineNewsletterPages}
    data-canva-node-id={node.id}
  >
    <div class="canva-newsletter-stage" data-newsletter-stage tabindex="-1" role="region" aria-label="Newsletter page preview">
      <div class="canva-newsletter-canvas" data-newsletter-canvas>
        <picture>
          <source media="(min-width: 601px)" srcset={withBase(firstPage.src)} data-newsletter-desktop-image />
          <img
            src={withBase('/fidelity/newsletter-cover-640.webp')}
            srcset={`${withBase('/fidelity/newsletter-cover-640.webp')} 640w, ${withBase(firstPage.src)} ${firstPage.width}w`}
            sizes="(max-width: 600px) 43vw, min(42vw, 575px)"
            width="640"
            height="904"
            alt="Ashley Naoko newsletter page 1 of 15"
            loading="lazy"
            decoding="async"
            draggable="false"
            data-newsletter-image
          />
        </picture>
        <div class="canva-newsletter-motion" data-newsletter-motion aria-hidden="true" hidden></div>
      </div>
      <button class="canva-newsletter-page-area canva-newsletter-page-area--previous" type="button" data-newsletter-page-previous aria-label="Previous page" tabindex="-1" disabled></button>
      <button class="canva-newsletter-page-area canva-newsletter-page-area--next" type="button" data-newsletter-page-next aria-label="Next page" tabindex="-1" disabled></button>
    </div>
    <span class="canva-newsletter-controls" aria-hidden="true"><span>1 / 15</span><span>›</span><span>⌕</span><span>•••</span><span>↗</span></span>
    <div class="canva-newsletter-toolbar">
      <button type="button" data-newsletter-prev aria-label="Previous newsletter page" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      </button>
      <span class="canva-newsletter-counter" data-newsletter-counter aria-live="polite">1 / {newsletter.pages.length}</span>
      <button type="button" data-newsletter-next aria-label="Next newsletter page" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      </button>
      <span class="canva-newsletter-divider" aria-hidden="true"></span>
      <details class="canva-newsletter-zoom">
        <summary aria-label="Zoom in and out">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15 15 6 6M6 10h8m-4-4v8" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </summary>
        <div class="canva-newsletter-zoom-panel">
          <input type="range" data-newsletter-zoom aria-label="Newsletter zoom" min="100" max="300" step="5" value="100" />
          <output data-newsletter-zoom-value aria-label="Newsletter zoom">100%</output>
          <button type="button" data-newsletter-fit>Fit</button>
        </div>
      </details>
      <details class="canva-newsletter-more">
        <summary aria-label="More newsletter options">
          <svg viewBox="0 0 24 24" aria-hidden="true"><g fill="currentColor"><circle cx="4" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="20" cy="12" r="2"/></g></svg>
        </summary>
        <div class="canva-newsletter-menu">
          <button type="button" data-newsletter-hide-controls>Hide controls</button>
          <a href={withBase('/newsletter/')} data-newsletter-standalone>Open standalone reader</a>
          <a href={withBase('/documents/ashley-naoko-newsletter.pdf')} download>Download PDF</a>
          <a href={withBase(firstPage.src)} data-newsletter-page-link>Open current page image</a>
        </div>
      </details>
      <button type="button" data-newsletter-fullscreen aria-label="Enter newsletter full screen" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M8 21H3v-5m13 5h5v-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
    <button class="canva-newsletter-show-controls" type="button" data-newsletter-show-controls aria-label="Show newsletter controls" hidden>&hellip;</button>
    <a class="canva-newsletter-link" href={withBase('/newsletter/')} aria-label="Read Ashley's complete 15-page newsletter">
      <span class="canva-newsletter-label">Open newsletter</span>
    </a>
    <p class="canva-newsletter-quality" data-newsletter-quality hidden>Preview-quality page. <a href={withBase('/newsletter/13/')}>Read the text version.</a></p>
    <p class="visually-hidden" data-newsletter-status role="status"></p>
    <p class="visually-hidden" data-newsletter-motion-status role="status"></p>
    <p class="media-error" role="status" hidden>
      <span data-newsletter-error>That newsletter page could not load.</span>
      <button type="button" data-newsletter-retry>Retry</button>
      <a href={withBase('/newsletter/')}>Open the standalone reader.</a>
    </p>
  </div>
)}
