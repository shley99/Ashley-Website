---
import { withBase } from '../lib/site';
interface Props { home?: boolean; complete?: boolean; }
const { home = false, complete = true } = Astro.props;
---
<header class="site-header">
  <nav class="site-nav" aria-label="Main navigation">
    {!home && <a class="home-link" href={withBase('/')} aria-label="Ashley Naoko, home">Ashley Naoko<span aria-hidden="true">.</span></a>}
    <a href={`${withBase('/')}#about`}>About</a>
    <a href={`${withBase('/')}#digital`}>Digital</a>
    {complete && <a href={`${withBase('/')}#physical`}>Physical</a>}
    <a href={`${withBase('/')}#contact`}>Contact</a>
    <button class="effects-toggle" type="button" data-effects-toggle aria-pressed="true" hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 11 4 3l6 4h4l6-4-1 8a8 8 0 1 1-14 0Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 12h1m6 0h1m-5 4 1 1 1-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <span><span class="effects-word">Effects </span><span data-effects-label>on</span></span>
    </button>
  </nav>
</header>
